<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Primero crea el modelo y luego las vistas -->

  <!-- Menú principal -->
  <menuitem id="menu_library_main" name="Library" sequence="10" />

  <!-- Submenú para miembros -->
  <menuitem id="menu_library_member" name="Members" parent="menu_library_main" sequence="10" />

  <!-- Vista árbol SIMPLIFICADA -->
  <record id="view_library_member_tree" model="ir.ui.view">
    <field name="name">library.member.tree</field>
    <field name="model">library.member</field>
    <field name="arch" type="xml">
      <tree>
        <field name="membership_number" />
        <field name="partner_id" />
        <field name="join_date" />
      </tree>
    </field>
  </record>

  <!-- Vista formulario SIMPLIFICADA -->
  <record id="view_library_member_form" model="ir.ui.view">
    <field name="name">library.member.form</field>
    <field name="model">library.member</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="membership_number" />
            <field name="partner_id" widget="res_partner_many2one" />
            <field name="join_date" />
            <field name="loan_count" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action PARA EL FINAL, después de que las vistas existan -->
  <record id="action_library_member" model="ir.actions.act_window">
    <field name="name">Library Members</field>
    <field name="res_model">library.member</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_library_member_tree" />
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first library member!
      </p>
    </field>
  </record>

  <!-- Actualizar el menú para usar la acción -->
  <menuitem id="menu_library_member_action" name="Members" parent="menu_library_member" action="action_library_member" sequence="10" />
</odoo>