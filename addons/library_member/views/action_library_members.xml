<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Acción para miembros -->
  <record id="action_library_members" model="ir.actions.act_window">
    <field name="name">Miembros</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('is_library_member', '=', True)]</field>
    <field name="context">{'default_is_library_member': True}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crea tu primer miembro de biblioteca.
      </p>
    </field>
  </record>

  <!-- Vista árbol -->
  <record id="view_library_member_tree" model="ir.ui.view">
    <field name="name">library.member.tree</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="loaned_books_count" widget="statinfo" />
      </tree>
    </field>
  </record>

  <!-- Vista formulario → SOLO COMPONENTE OWL -->
  <record id="view_library_member_form" model="ir.ui.view">
    <field name="name">library.member.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <form string="Miem de Biblioteca">
        <sheet>
          <widget name="web_owl_counter" />
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_library_member_form" model="ir.ui.view">
    <field name="name">library.member.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <form string="Miembro de Biblioteca">
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <group>
              <field name="email" widget="email" />
              <field name="phone" widget="phone" />
            </group>
          </group>
          <separator string="Actividad en Biblioteca" />
          <widget name="web_owl_counter" />
        </sheet>
      </form>
    </field>
  </record>
</odoo>