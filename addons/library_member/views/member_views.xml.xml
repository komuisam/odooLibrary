<!-- library_member/views/member_views.xml -->
<odoo>
  <record id="view_library_member_form" model="ir.ui.view">
    <field name="name">library.member.form</field>
    <field name="model">library.member</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="partner_id" />
            <widget name="loan_counter" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_library_member_tree" model="ir.ui.view">
    <field name="name">library.member.tree</field>
    <field name="model">library.member</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="loan_count" />
      </tree>
    </field>
  </record>

  <menuitem id="menu_library_root" name="Library" />

  <menuitem id="menu_library_members" name="Members" parent="menu_library_root" />

  <record id="action_library_member" model="ir.actions.act_window">
    <field name="name">Members</field>
    <field name="res_model">library.member</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_library_member_action" name="Members" parent="menu_library_members" action="action_library_member" />
</odoo>