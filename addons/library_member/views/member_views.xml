<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Acción para miembros -->
  <record id="action_library_members" model="ir.actions.act_window">
    <field name="name">Miembros</field>
    <field name="res_model">library.member</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'default_active': true}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear un nuevo miembro
      </p>
    </field>
  </record>

  <!-- Vista árbol para miembros -->
  <record id="view_library_member_tree" model="ir.ui.view">
    <field name="name">library.member.tree</field>
    <field name="model">library.member</field>
    <field name="arch" type="xml">
      <tree string="Miembros">
        <field name="name" />
        <field name="email" />
        <field name="phone" />
        <field name="loaned_books_count" widget="statinfo" />
        <field name="membership_date" />
        <field name="active" widget="boolean_button" />
      </tree>
    </field>
  </record>

  <!-- Vista formulario para miembros -->
  <record id="view_library_member_form" model="ir.ui.view">
    <field name="name">library.member.form</field>
    <field name="model">library.member</field>
    <field name="arch" type="xml">
      <form string="Miembro">
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="email" />
              <field name="phone" />
            </group>
            <group>
              <field name="membership_date" />
              <field name="loaned_books_count" widget="statinfo" />
              <field name="active" />
            </group>
          </group>

          <!-- Pestaña de préstamos -->
          <notebook>
            <page string="Préstamos">
              <field name="loan_ids" context="{'default_member_id': id}">
                <tree>
                  <field name="book_id" />
                  <field name="loan_date" />
                  <field name="return_date" />
                  <field name="state" />
                </tree>
                <form>
                  <group>
                    <field name="book_id" />
                    <field name="loan_date" />
                    <field name="return_date" />
                    <field name="state" />
                  </group>
                </form>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>